# ==============================================================================
# ShopSphere Server — Production Environment Template (.env.production.example)
# ==============================================================================

NODE_ENV=production
PORT=5000

# Client Origins & CORS Allowlist (SEC-12 - No wildcards in production)
CLIENT_URL=https://shopsphere.example.com
CORS_ORIGINS=https://shopsphere.example.com,https://admin.shopsphere.example.com

# MongoDB Atlas 3-Node Dedicated Replica Set (NFR-AVAIL-02, NFR-AVAIL-03)
MONGODB_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD>@<CLUSTER_HOST>/shopsphere_prod?retryWrites=true&w=majority

# JWT Authentication Secrets (SEC-02 - Minimum 64 hex characters)
JWT_SECRET=replace_with_64_character_hex_secret_in_production_environment
JWT_REFRESH_SECRET=replace_with_separate_64_character_hex_secret_in_production

# 2FA Application-Layer Secret Encryption Key (SEC-17 - 64 hex chars for AES-256-GCM)
TWO_FA_ENCRYPTION_KEY=replace_with_64_hex_character_key_for_aes_256_gcm_2fa_encryption

# Live Payment Gateway (Stripe Live Keys)
STRIPE_SECRET_KEY=sk_live_replace_with_production_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_production_stripe_webhook_signing_secret

# Observability & Monitoring (Phase 4.3)
SENTRY_DSN=https://example@o123456.ingest.sentry.io/1234567
LOG_LEVEL=info

# High-Performance Cache (Optional Redis Cluster - NFR-PERF-03)
REDIS_URL=rediss://default:<REDIS_PASSWORD>@<REDIS_HOST>:6379

# Asset Delivery CDN (NFR-PERF-04)
CDN_BASE_URL=https://cdn.shopsphere.example.com
