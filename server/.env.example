# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://localhost:27017/shopsphere

# Cryptographic Secrets (SEC-02, SEC-06, SEC-17)
JWT_SECRET=your_jwt_256_bit_secret_change_in_production
STEP_UP_SECRET=your_step_up_elevation_secret_change_in_production
TWO_FA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Payment Gateway (PAY-FR-01 to 05) - Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Transactional Notifications (NOT-FR-01, NOT-FR-03)
# Brevo (formerly Sendinblue) - Mails
BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM=notifications@shopsphere.marketplace

# TextBee - SMS & 2FA
TEXTBEE_API_KEY=your_textbee_api_key
TEXTBEE_DEVICE_ID=default_device

# Monitoring & Observability (SEC-22, Step 4.3)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
