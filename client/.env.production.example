# Backend API Root URL
VITE_API_URL=https://api.shopsphere.example.com/api/v1

# Stripe Live Publishable Key
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_replace_with_production_publishable_key

# Global CDN Asset Delivery URL (NFR-PERF-04)
VITE_CDN_BASE_URL=https://cdn.shopsphere.example.com
